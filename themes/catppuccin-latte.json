    "animation": {
        "scale": 1
    },
    "bar": {
        "height": 44
    },
    "wallpaper": {
        "static": "wallpapers/catppuccin-latte.jpg",
        "shader": "shaders/ondas.qsb"
    },
    "hyprland": {
        "activeBorder": "#1e66f5",
        "inactiveBorder": "#bcc0cc",
        "borderSize": 2,
        "rounding": 12,
        "blurSize": 8,
        "blurPasses": 2
    },
    "transparency": {
        "enabled": true,
        "base": 0.85,
        "layers": 0.45
    },
    "surfaces": {
        "outline": false
    },
    "fonts": [
        "fonts/Rubik[wght].ttf"
    ]
