{
    "name": "Catppuccin Latte",
    "description": "A versão clara do Catppuccin: azul e malva vivos sobre um branco-acinzentado suave.",
    "dark": false,
    "colors": {
        "base": "#eff1f5",
        "surface": "#e6e9ef",
        "raised": "#dce0e8",
        "border": "#bcc0cc",
        "text": "#4c4f69",
        "textMuted": "#5c5f77",
        "textFaint": "#8c8fa1",
        "accent": "#1e66f5",
        "accentText": "#eff1f5",
        "danger": "#d20f39",
        "success": "#40a02b",
        "warning": "#df8e1d",
        "track": "#ccd0da"
    },
    "font": {
        "sans": "Rubik",
        "mono": "CaskaydiaCove Nerd Font",
        "icon": "Material Symbols Rounded",
        "size": {
            "small": 11,
            "normal": 13,
            "large": 16,
            "huge": 44
        }
    },
    "radius": {
        "small": 8,
        "normal": 14,
        "large": 22
    },
    "spacing": {
        "tiny": 4,
        "small": 8,
        "normal": 12,
        "large": 20
